# Antigravity Image Server configuration
# Copy this template to .env. Never commit the real .env file.

PORT=3333
# Local-only by default. Keep this unless a trusted HTTPS reverse proxy is configured.
HOST=127.0.0.1
PUBLIC_BASE_URL=http://localhost:3333

# Optional on loopback. Required for any remote access, minimum 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# API_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
# Browser playground, if protected: sessionStorage.setItem('apiToken', 'your-token')

# Remote access example (uncomment and configure every value together).
# For TLS termination, preserve the public Host header at the reverse proxy.
# HOST=0.0.0.0
# ALLOW_REMOTE_ACCESS=true
# API_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
# ALLOWED_HOSTS=api.example.com
# CORS_ORIGIN=https://app.example.com
# PUBLIC_BASE_URL=https://api.example.com

# Google AI Studio API (optional; CLI fallback is used without a key).
# GEMINI_API_KEY=
# GEMINI_FREE_MODEL=gemini-3.1-flash-image
# IMAGEN_MODEL=imagen-4.0-fast-generate-001
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# API_TIMEOUT_MS=60000
API_CONCURRENCY=4
FREE_API_CONCURRENCY=2

# Antigravity CLI fallback. Sandbox is enabled by default.
# AGY_PATH=C:\Users\YourName\AppData\Local\agy\bin\agy.exe
# CLI_TIMEOUT_MS=600000
MAX_CONCURRENCY=1
# AGY_MODEL=gemini-3.8-flash-low
# AGY_EFFORT=low
# Deliberate local-only unsafe override. Never set this for remote access:
# AGY_SKIP_PERMISSIONS=true
# Deliberate local-only sandbox opt-out. Never set this for remote access:
# AGY_SANDBOX=false

# Generated image storage. New output is refused after this limit; files are not auto-deleted.
# STORAGE_DIR=./generated_images
MAX_STORAGE_MB=2048

# Optional visual inspiration search. Provider keys stay server-side.
# BRAVE_SEARCH_API_KEY=
# BRAVE_SEARCH_LANG=fr
# Pinterest partner search is beta and may require app approval.
# PINTEREST_ACCESS_TOKEN=
# PINTEREST_COUNTRY_CODE=NG
# PINTEREST_LOCALE=fr-FR
